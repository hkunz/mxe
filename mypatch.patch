+# This file is part of MXE. See LICENSE.md for licensing information.
+# Initial package scaffold generated with the "gsrc" tool:
+# https://github.com/hkunz/git-fetcher
+
+include src/common/pkgconfig-generator.mk
+
+PKG             := skcms
